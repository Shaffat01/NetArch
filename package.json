{
  "name": "netarch-ip-inventory",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "IP-centric network infrastructure inventory ETL: xlsx ingest, normalize, resolve, merge, connectivity graph, Fastify API and web UI",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "ingest": "tsx src/ingest/cli.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "legacy:start": "node server.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jsdom": "26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
