# LibreNMS API (read-only token recommended)
LIBRENMS_URL=https://librenms.example.local
LIBRENMS_TOKEN=replace-with-read-only-token

# Zabbix API — use either API token OR username/password
ZABBIX_URL=https://zabbix.example.local
ZABBIX_TOKEN=
ZABBIX_USERNAME=
ZABBIX_PASSWORD=

# Live sync
LIVE_REFRESH_SECONDS=60
LIVE_TIMEOUT_MS=15000
LIVE_TLS_REJECT_UNAUTHORIZED=true
AUTO_DISCOVER=true
